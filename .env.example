# Set to true to serve HTTPS using the certificate paths below
IS_PRODUCTION=false
PORT=3000

# MySQL (expects a school_data(id, name) table; each row becomes a chat room)
DB_HOST=localhost
DB_PORT=3306
REMOVED
DB_PASSWORD=
DB_NAME=chat

# Required when IS_PRODUCTION=true
SSL_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem
SSL_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
